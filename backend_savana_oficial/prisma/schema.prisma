datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  cpf       String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Pet {
  id          Int      @id @default(autoincrement())
  name        String
  species     String
  age         Int
  breed       String
  description String
  image       String?
  createdAt   DateTime @default(now())
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  image       String?
  price       Float
  category    String
  createdAt   DateTime @default(now())
}